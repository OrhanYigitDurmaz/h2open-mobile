<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to any host, so a phone can reach an Odoo
     running on a PC in the same network (http://192.168.x.x:8069).
     Release builds use src/main's HTTPS-only config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
